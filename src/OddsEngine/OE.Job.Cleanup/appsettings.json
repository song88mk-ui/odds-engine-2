{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "Minimumlevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Telemetry": {
    "Enabled": true,
    "Environment": "dev"
  },
  "MessageBroker": {
    "Host": "",
    "Port": "5671",
    "Username": "",
    "Password": "",
    "VirtualHost": "/",
    "Exchange": "e.central",
    "Queue": "q.oe.job.cleanup",
    "Consumer": "OE.Job.Cleanup",
    "RoutingKey": "r.bet.placement"
  },
  "ConnectionStrings": {
    "Betting": ""
  },
  "Custom": {
    "Enabled": false,
    "MongoDB-Sportsbook": "mongodb://localhost/sportsbook",
    "DbContextTimeout": 180,
    "SportRetention": -30,
    "OrphanCleanupDryRun": false,
    "OrphanSweepIntervalHours": 24,
    "UtcWindowHours": {
      "Start": 1,
      "End": 10
    }
  }
}
