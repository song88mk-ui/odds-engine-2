{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "Minimumlevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "MessageBroker": {
    "Host": "",
    "Port": "5671",
    "Username": "",
    "Password": "",
    "VirtualHost": "/",
    "Exchange": "e.central",
    "Queue": "q.oe.translation",
    "Consumer": "OE.Translation.Service",
    "RoutingKey": "r.bg.receiver.onfixturechange|r.bg.receiver.onmarketchange|r.oe.ontranslationchange"
  },
  "ConnectionStrings": {
    "Translation": ""
  },
  "Custom": {
    "MongoDB-Sportsbook": "mongodb://10.49.100.55:27017/sportsbook?retryWrites=true&w=0",
    "DbContextTimeout": 180,
    "Translation": {
      "CacheSeed": false,
      "CacheBackfill": true
    }
  }
}
