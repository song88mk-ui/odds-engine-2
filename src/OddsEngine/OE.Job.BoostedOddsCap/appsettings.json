{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "Minimumlevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Telemetry": {
    "Enabled": true,
    "Environment": "dev"
  },
  "MessageBroker": {
    "Host": "",
    "Port": "5671",
    "Username": "",
    "Password": "",
    "VirtualHost": "/",
    "Exchange": "e.central",
    "Queue": "q.oe.job.boostedoddscap",
    "Consumer": "OE.Job.BoostedOddsCap",
    "RoutingKey": "r.oe.sb.engine.onoddschange",
    "IsExclusive": true,
    "PrefetchCount": 1000
  },
  "ConnectionStrings": {
    "Trading": ""
  },
  "Custom": {
    "Enabled": false,
    "DbContextTimeout": 30,
    "RefreshSeconds": 60,
    "HysteresisPercent": 0.25,
    "StartupSilentSeconds": 120,
    "AlertBufferSize": 1000,
    "BatchWindowSeconds": 5,
    "ConsumerCheckSeconds": 30,
    "ConsumerDeadChecks": 2,
    "StatusLogSeconds": 60,
    "PlayerPropMarketTemplateIds": ""
  },
  "Notification": {
    "Page": "Price Boost",
    "PageRedirect": "/hk/odds-engine/manage-boost",
    "ClaimType": "SBC.OE.PriceBoost.Manage",
    "Type": 1,
    "RoutingKey": "r.oe.bm.engine.notifications",
    "MessageType": "OnNewNotification",
    "SummaryThreshold": 5
  },
  "Email": {
    "Enabled": false,
    "From": "Notifications <noreply@song88.com>",
    "Subject": "Song88 | Price Boost Threshold Crossed",
    "OverrideRecipient": "",
    "MaxPerRecipientPerHour": 10,
    "BackofficeUrl": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 10
    }
  }
}
